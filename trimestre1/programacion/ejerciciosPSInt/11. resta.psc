Algoritmo resta_
	//Juan Diego Rios
	//Hacer un algoritmo que lea dos n�meros enteros A y B
	//y muestre su diferencia.
	
	Definir num1,num2 Como Entero;
	Definir resta Como Entero;
	
	Escribir "Ingrese el valor del primer numero";
	Leer num1;
	
	Escribir "Ingrese el valor del segundo numero";
	Leer num2;
	
	resta<-num1-num2
	
	Escribir "El resultado de la diferencia de ",num1," y ",num2," es ",resta;
FinAlgoritmo
