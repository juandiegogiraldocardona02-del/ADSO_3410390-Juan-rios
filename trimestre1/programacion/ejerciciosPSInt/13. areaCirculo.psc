Algoritmo areaCirculo
	// Pedir el radio de un círculo 
	//y calcular su área. A=PI*r^2.
	
	Definir radio como real;
	Definir area como real;
	
	numeroPI<-3.1416
	
	Escribir "Indique la medida del radio del circulo";
	Leer radio;
	
	area<-numeroPI*(radio^2)
	
	Escribir "El área del círculo es ", area," centimetros cuadrados";	
	
FinAlgoritmo