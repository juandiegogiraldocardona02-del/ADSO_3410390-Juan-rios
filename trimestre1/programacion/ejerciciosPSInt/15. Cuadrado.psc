Algoritmo Cuadrado
	// Pedir el lado de un cuadrado, 
	//mostrar su área y su perímetro.
	
	Definir lado1, lado2 como real;
	Definir area como real;
	Definir perimetro como real;
	
	Escribir "Ingrese la medida del primer lado";
	Leer lado1;
	
	Escribir "Ingrese la medida del segundo lado";
	Leer lado2;
	
	area<-(lado1*lado2)
	perimetro<-(lado1+lado2)*2
	
	Escribir "El área del cuadrado es de ",area," centimetros cuadrados"
	Escribir "El perimetro del cuadrado es de ",perimetro," centimetros"
	
FinAlgoritmo
