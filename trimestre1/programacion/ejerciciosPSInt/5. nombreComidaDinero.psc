Algoritmo nombreComidaDinero
	//Juan Diego Rios
	// Hacer un Algoritmo qie declare una variable para guardar el nonbre de una persona, 
	//otra para guardar la comida preferida 
	//y otra para guardar la cantidad de dinero que posee
	
	Definir nombre como cadena;
	Definir comidaPreferida como cadena;
	Definir recursos como entero; 
	
	Escribir "Ingrese su nombre completo";
	Leer nombre;
	
	Escribir "Ingrese su comida preferida";
	Leer comidaPreferida;

	Escribir "Indique la cantidad de dinero que posee actualmente en su bolsillo";
	Leer recursos;
	
	Escribir "La comida preferida de ",nombre," es la ",comidaPreferida," y cuenta con $ ",recursos," pesos para comprar dos unidades";
FinAlgoritmo