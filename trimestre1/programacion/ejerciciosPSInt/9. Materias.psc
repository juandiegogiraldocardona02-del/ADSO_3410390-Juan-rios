Algoritmo Materias
	//Juan Diego Rios
	//Hacer un algoritmo que lea el nombre de un estudiante, 
	//la cantidad de materias perdidas y la cantidad de materias ganadas.
	
	Definir nombrEstudiante como cadena;
	Definir materiasGanadas Como Entero;
	Definir materiasPerdidas como entero;
	
	Escribir "Escriba el nombre completo de estudiante";
	Leer nombrEstudiante;
	
	Escribir "Ingrese el total de materias ganadas***";
	Leer materiasGanadas;
	
	Escribir "***Ingrese el total de materias perdidas";
	Leer materiasPerdidas;
	
	Escribir "El estudiante ",nombrEstudiante," tuvo un total de ",materiasGanadas," materias ganadas, y un total de ",materiasPerdidas," materias perdidas.";
	
FinAlgoritmo
