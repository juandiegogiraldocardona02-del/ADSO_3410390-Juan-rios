Algoritmo Multiplos
	//Juan Diego Rios
	//Pedir dos n�meros y decir si uno es m�ltiplo del otro.
	
	Definir num1,num2 Como Entero;
	
	Escribir "Escriba el valor del primer numero";
	Leer num1;
	
	Escribir "Escriba el valor del segundo numero";
	Leer num2;
	
	si num1%num2=0 Entonces
		Escribir "Los numeros ingresados son multiplos";
	SiNo
		Escribir "Los numeros ingresados NO son multiplos";
	FinSi
FinAlgoritmo
