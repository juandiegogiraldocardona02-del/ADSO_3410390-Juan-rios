Algoritmo rectangulo
	//Calcular el área de un rectángulo de lados A e B.
	
	Definir A Como Real;
	Definir B Como Real;
	Definir area como real;
	
	Escribir "Indique la medida del lado A";
	Leer A
	Escribir "Indique la medida del lado B";
	Leer B
	
	area<-(A*B)
	
	Escribir "El area del rectángulo es de ",area," centimetros cuadrados";	
	
FinAlgoritmo
