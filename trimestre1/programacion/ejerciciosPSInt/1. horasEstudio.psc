Algoritmo horasEstudio
	
	//Juan Diego Rios
	//Hacer un Algoritmo que declare una variable para guardar el numero de horas de estudio, y otra para guardar el nombre. Escribir ambos datos 
	
	// Definici�n de variables
	Definir horas Como Real;
	Definir nombre como cadena;
	
	Escribir "Ingrese el nombre completo del estudiante ";
	Leer nombre;
	
	Escribir "Ingrese el total de horas estudiadas ";
	Leer horas;
	
	Escribir "El estudiante ",nombre," en total estudio ", horas," horas.";
	
FinAlgoritmo
