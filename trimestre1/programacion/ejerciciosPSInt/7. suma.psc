Algoritmo Suma_
	//Juan Diego Rios
	//Hacer un Algoritmo para sumar dos numeros,
	//los cuales seran tecleados por el usuario.
	//Mostrar el resultado
	
	Definir num1,num2 Como Entero;
	Definir suma Como Entero;
	
	Escribir "Ingrese el valor del primer numero";
	Leer num1;
	
	Escribir "Ingrese el valor del segundo numero";
	Leer num2;
	
	suma<-num1+num2
	
	Escribir "El resultado de la suma de ",num1," y ",num2," es ",suma;
		
FinAlgoritmo
