Algoritmo Igualdad
	//Juan Diego Rios
	// Pedir dos n�meros y decir si son iguales o no
	
	Definir num1, num2 como entero;
	
	Escribir "Escriba el balor de numero uno";
	Leer num1;
	Escribir "Escriba el balor de numero dos";
	leer num2;
	si num1=num2 Entonces
		Escribir "Los numeros indicados son iguales";
	SiNo
		Escribir "Los numeros indicados son diferentes";			
	FinSi
	
FinAlgoritmo
