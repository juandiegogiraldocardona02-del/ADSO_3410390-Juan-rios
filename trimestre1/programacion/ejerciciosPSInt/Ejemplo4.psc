Algoritmo Ejemplo4
	//Juan Diego Rios
	// Solicitar tres numero y mostrar el promedio en pantalla
	
	//Definir varibales
	Definir num1, num2, num3 como Entero;
	Definir promedio como real;
	
	//Entrada de datos
	Escribir "Ingrese el valor de los tres numeros";
	Leer num1, num2, num3;
	
	//Proceso 
	promedio<- (num1+num2+num3)/3;
	
	//Salida
	Escribir "El promedio de los tres numeros ingresados es: ",promedio;
	
	
FinAlgoritmo
