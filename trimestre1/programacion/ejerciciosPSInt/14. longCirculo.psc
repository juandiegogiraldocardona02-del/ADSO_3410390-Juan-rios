Algoritmo longCirculo
	//Pedir el radio de una circunferencia 
	//y calcular su longitud.
	
	Definir longCirc como real;
	definir numeroPI como real;
	Definir radio como real;
	
	Escribir "Ingrese la medida del radio";
	Leer radio;
	numeroPI<-3.1416
	longCirc<-2*numeroPI*radio
	
	
	Escribir "La longitud del circulo es de ",longCirc," centimetros"
	
FinAlgoritmo
