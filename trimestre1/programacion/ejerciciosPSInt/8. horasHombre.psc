Algoritmo horasHombre
	//Juan Diego Rios
	//Hacer un algoritmo que lea el nombre de una persona 
	//y n�mero de horas que estudia en la semana.
	
	Definir nombrePersona como cadena;
	definir horasTrabajadas como real;
	
	Escribir "Escriba el nombre completo del colaborador";
	Leer nombrePersona;
	
	Escribir "Ingrese el total de horas laboradas en la semana";
	leer horasTrabajadas;
	
	Escribir nombrePersona," trabajo un total de ",horasTrabajadas," horas en la semana."
	
FinAlgoritmo